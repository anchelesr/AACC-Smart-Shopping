@startuml
title Smart Shopping - Logical Component Architecture
left to right direction
skinparam shadowing false
skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam componentBackgroundColor #FFF4F4
skinparam componentBorderColor #B52330
skinparam componentFontColor #202025
package "Web Presentation" {
 component "React 18 SPA" as UI
}
package "Modular FastAPI Backend" {
 component "REST / Pydantic Validation" as API
 component "Catalog and Price Query" as Query
 component "Discount Evidence" as Discount
 component "Recommendation Rules" as Rec
}
package "Scheduled Processing" {
 component "Idempotent Price Import" as Import
 component "Carbon Policy Controller" as Policy
 component "Forecast Adapter / Worker" as Forecast
}
database "PostgreSQL 16\nProducts, Retailers, Price Observations,\nForecast Runs, Job Logs" as DB
cloud "Approved CSV / API" as Source
cloud "Simulated Grid Carbon Signal" as Carbon
component "Prometheus-compatible Metrics" as Metrics
UI --> API : JSON over HTTPS
API --> Query
API --> Discount
API --> Rec
Query --> DB : Price and forecast reads
Discount --> Query
Rec --> Query : Evidence and forecast status
Import --> Source : Validated import
Import --> DB : Idempotent upsert
Policy --> Carbon : Read signal
Policy --> DB : Due-by job state
Policy --> Forecast : RUN / DEFER
Forecast --> DB : Store versioned 7-day forecast
API ..> Metrics
Import ..> Metrics
Policy ..> Metrics
Forecast ..> Metrics
@enduml
