@startuml
title Smart Shopping - Conceptual Relational Data Model
skinparam shadowing false
skinparam backgroundColor white
class Product {
  id: PK
  sku: UNIQUE
  brand: String
  model: String
  specifications: JSONB
}
class Retailer {
  id: PK
  name: UNIQUE
  defaultCurrency: String
}
class PriceObservation {
  id: PK
  productId: FK
  retailerId: FK
  amount: Decimal
  currency: String
  observedAt: UTC
  sourceProvenance: String
}
class ForecastRun {
  id: PK
  productId: FK
  forecast7Days: JSONB
  modelVersion: String
  generatedAt: UTC
  status: String
}
class JobExecutionLog {
  id: PK
  jobKey: UNIQUE
  deadlineAt: UTC
  status: String
  gridIntensity: Decimal
  energyKWh: Decimal
  estimatedGCO2e: Decimal
}
Product "1" -- "0..*" PriceObservation
Retailer "1" -- "0..*" PriceObservation
Product "1" -- "0..*" ForecastRun
Product "1" -- "0..*" JobExecutionLog
note right of PriceObservation
 UNIQUE(productId, retailerId,
 observedAt, sourceProvenance)
end note
@enduml
